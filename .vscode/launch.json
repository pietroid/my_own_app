{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "command": "npm run start:local"
    },
    {
      "name": "App (web)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port",
        "5173",
        "--dart-define-from-file",
        "env/dev.json"
      ]
    },
    {
      "name": "App (phone)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "args": ["--flavor", "dev", "--dart-define-from-file", "env/dev.json"]
    },
    {
      "name": "Server tests",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "command": "npm test -- --runInBand"
    }
  ],
  "compounds": [
    {
      "name": "Server + App (web)",
      "configurations": ["Server", "App (web)"],
      "stopAll": true
    },
    {
      "name": "Server + App (phone)",
      "configurations": ["Server", "App (phone)"],
      "stopAll": true
    }
  ]
}
